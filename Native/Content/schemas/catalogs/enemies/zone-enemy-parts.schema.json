{
  "schema_version": 1,
  "table": "zone-enemy-parts",
  "description": "Each template's equipment parts; a part with no row is all zeros.",
  "key": ["enemy", "part"],
  "columns": [
    {
      "name": "enemy",
      "type": "reference",
      "references": "zone-enemies",
      "description": "the template"
    },
    {
      "name": "display_name",
      "type": "text",
      "optional": true,
      "description": "Informational plain-text label; not a key or gameplay value."
    },
    {
      "name": "part",
      "type": "id",
      "description": "weapon.blade, weapon.grip, weapon.gem1-3, shield.base, shield.gem1-3, accessory or limb0-5.armor"
    },
    {
      "name": "item_id",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "the global item id, which names the part"
    },
    {
      "name": "sub_id",
      "type": "integer",
      "minimum": -128,
      "maximum": 127,
      "description": "the item's 1-based index in its family: item_id less 0 for a blade, 95 for a grip, 126 for a shield, armour or accessory, 260 for a gem"
    },
    {
      "name": "weapon_model_id",
      "type": "integer",
      "minimum": -128,
      "maximum": 127,
      "description": "a blade's or shield's WEP model (OBJ/<two hex digits>.WEP, converted to models/weapons/<two hex digits>.gltf); 0 for other parts"
    },
    {
      "name": "category",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "a blade's category (1 dagger .. 9 crossbow), which with a model also picks the enemy's attack animations; a grip's type (1-4); an armour piece's (1 shield, 2 helm, 3 breast armour, 4 leggings, 5 glove, 7 accessory); 0 for a gem"
    },
    {
      "name": "strength",
      "type": "integer",
      "minimum": -128,
      "maximum": 127,
      "description": "strength the part adds; a weapon sums its blade, grip and gems, a shield its base and gems"
    },
    {
      "name": "intelligence",
      "type": "integer",
      "minimum": -128,
      "maximum": 127,
      "description": "intelligence the part adds; summed as strength"
    },
    {
      "name": "agility",
      "type": "integer",
      "minimum": -128,
      "maximum": 127,
      "description": "agility the part adds; summed as strength"
    },
    {
      "name": "current_dp",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "current DP (equal to max_dp on the disc)"
    },
    {
      "name": "max_dp",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "maximum DP of a blade, shield or armour piece"
    },
    {
      "name": "current_pp",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "current PP (zero on the disc)"
    },
    {
      "name": "max_pp",
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "maximum PP of a blade or shield"
    },
    {
      "name": "damage_type",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "blunt",
        "2": "edged",
        "3": "piercing"
      },
      "legacy_numeric_aliases": true,
      "description": "the blade's damage type"
    },
    {
      "name": "cost_type",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "mp",
        "2": "risk",
        "3": "hp",
        "4": "weapon-pp"
      },
      "legacy_numeric_aliases": true,
      "description": "the resource the blade's base attack costs"
    },
    {
      "name": "cost",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "how much each of the blade's attacks costs"
    },
    {
      "name": "material",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "wood",
        "2": "leather",
        "3": "bronze",
        "4": "iron",
        "5": "hagane",
        "6": "silver",
        "7": "damascus"
      },
      "legacy_numeric_aliases": true,
      "description": "the part's material (zero on the disc: templates keep weapon, shield and armour materials in their own columns)"
    },
    {
      "name": "recovery_delay",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "the blade's recovery delay after an attack, for actions that take the weapon's delay"
    },
    {
      "name": "gem_slots",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "how many gems a grip or shield holds"
    },
    {
      "name": "gem_effects",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "a gem's effect (0 none): 1/2 physical/spell hit bonus, 3/4 +5% physical/spell damage, 5/6 physical/spell evasion, 7/8 -5% physical/spell damage taken, 9 PP gain; 11-14, 16, 18, 19 and 21 evade specific action effects"
    },
    {
      "name": "range",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "the blade's reach; the enemy's reach is added to it and to the other two extents"
    },
    {
      "name": "range_y",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "the attack area's second extent"
    },
    {
      "name": "range_z",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "the attack area's third extent"
    },
    {
      "name": "attack_shape",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "ellipsoid",
        "2": "centered-cylinder",
        "3": "cylinder",
        "4": "cone",
        "5": "reversed-cone",
        "6": "rectangle",
        "7": "diamond"
      },
      "legacy_numeric_aliases": true,
      "description": "the blade's targeting volume; actions use the same domain"
    },
    {
      "name": "attack_angle",
      "type": "integer",
      "minimum": 0,
      "maximum": 31,
      "description": "the attack area's angle"
    },
    {
      "name": "type_none",
      "type": "integer",
      "legacy_name": "type_1",
      "minimum": -128,
      "maximum": 127,
      "description": "signed physical-type rating"
    },
    {
      "name": "type_blunt",
      "type": "integer",
      "legacy_name": "type_2",
      "minimum": -128,
      "maximum": 127,
      "description": "signed physical-type rating"
    },
    {
      "name": "type_edged",
      "type": "integer",
      "legacy_name": "type_3",
      "minimum": -128,
      "maximum": 127,
      "description": "signed physical-type rating"
    },
    {
      "name": "type_piercing",
      "type": "integer",
      "legacy_name": "type_4",
      "minimum": -128,
      "maximum": 127,
      "description": "signed physical-type rating"
    },
    {
      "name": "class_human",
      "type": "integer",
      "legacy_name": "class_1",
      "minimum": -128,
      "maximum": 127,
      "description": "signed class rating"
    },
    {
      "name": "class_beast",
      "type": "integer",
      "legacy_name": "class_2",
      "minimum": -128,
      "maximum": 127,
      "description": "signed class rating"
    },
    {
      "name": "class_undead",
      "type": "integer",
      "legacy_name": "class_3",
      "minimum": -128,
      "maximum": 127,
      "description": "signed class rating"
    },
    {
      "name": "class_phantom",
      "type": "integer",
      "legacy_name": "class_4",
      "minimum": -128,
      "maximum": 127,
      "description": "signed class rating"
    },
    {
      "name": "class_dragon",
      "type": "integer",
      "legacy_name": "class_5",
      "minimum": -128,
      "maximum": 127,
      "description": "signed class rating"
    },
    {
      "name": "class_evil",
      "type": "integer",
      "legacy_name": "class_6",
      "minimum": -128,
      "maximum": 127,
      "description": "signed class rating"
    },
    {
      "name": "affinity_physical",
      "type": "integer",
      "legacy_name": "affinity_1",
      "minimum": -128,
      "maximum": 127,
      "description": "signed elemental affinity"
    },
    {
      "name": "affinity_air",
      "type": "integer",
      "legacy_name": "affinity_2",
      "minimum": -128,
      "maximum": 127,
      "description": "signed elemental affinity"
    },
    {
      "name": "affinity_fire",
      "type": "integer",
      "legacy_name": "affinity_3",
      "minimum": -128,
      "maximum": 127,
      "description": "signed elemental affinity"
    },
    {
      "name": "affinity_earth",
      "type": "integer",
      "legacy_name": "affinity_4",
      "minimum": -128,
      "maximum": 127,
      "description": "signed elemental affinity"
    },
    {
      "name": "affinity_water",
      "type": "integer",
      "legacy_name": "affinity_5",
      "minimum": -128,
      "maximum": 127,
      "description": "signed elemental affinity"
    },
    {
      "name": "affinity_light",
      "type": "integer",
      "legacy_name": "affinity_6",
      "minimum": -128,
      "maximum": 127,
      "description": "signed elemental affinity"
    },
    {
      "name": "affinity_dark",
      "type": "integer",
      "legacy_name": "affinity_7",
      "minimum": -128,
      "maximum": 127,
      "description": "signed elemental affinity"
    }
  ]
}
