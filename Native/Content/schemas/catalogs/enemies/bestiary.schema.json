{
  "schema_version": 1,
  "table": "bestiary",
  "description": "Encyclopedia definitions. Selection, highlights, unlocked state and navigation links belong to each UI session.",
  "key": ["id"],
  "columns": [
    {
      "name": "id",
      "type": "id",
      "description": "Stable encyclopedia definition identity, not a spawned enemy."
    },
    {
      "name": "display_name",
      "type": "text",
      "optional": true,
      "description": "Informational plain-text label; not a key or gameplay value."
