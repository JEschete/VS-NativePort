    },
    {
      "name": "first_category",
      "type": "integer",
      "minimum": 2,
      "maximum": 5,
      "description": "The first ingredient's category."
    },
    {
      "name": "second_material",
      "type": "integer",
      "minimum": 0,
      "maximum": 7,
      "description": "The second ingredient's material."
    },
    {
      "name": "second_category",
      "type": "integer",
      "minimum": 2,
      "maximum": 5,
      "description": "The second ingredient's category."
    },
    {
      "name": "material",
      "type": "integer",
      "minimum": 1,
      "maximum": 7,
      "description": "The combined item's material."
    }
  ]
