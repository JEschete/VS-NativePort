{
  "schema_version": 1,
  "table": "action-hits",
  "description": "Each action's hits; an action has at most two.",
  "key": ["action", "slot"],
  "columns": [
    {
      "name": "action",
      "type": "reference",
      "references": "actions",
      "description": "The action the hit belongs to."
    },
    {
      "name": "display_name",
      "type": "text",
      "optional": true,
      "description": "Informational plain-text label; not a key or gameplay value."
    },
    {
      "name": "slot",
      "type": "enum",
      "enum": {
        "0": "first",
        "1": "second"
      },
      "legacy_numeric_aliases": true,
      "description": "Which of the action's two hits. An absent hit is an all-zero word, so only hits that do something have a row."
    },
    {
      "name": "effect",
      "type": "integer",
      "minimum": 0,
      "maximum": 127,
      "description": "The hit's effect, an index into the battle effect table; not yet named."
    },
    {
      "name": "prerequisite",
      "type": "enum",
      "enum": {
        "0": "never-0",
        "1": "always-0",
        "2": "always-1",
        "3": "always-2",
        "4": "undead",
        "5": "not-undead",
        "6": "never-1",
        "7": "never-2",
        "8": "never-3",
        "9": "can-apply-strength-down",
        "10": "can-apply-intelligence-down",
        "11": "can-apply-agility-down",
        "12": "can-apply-equipment-down",
        "13": "can-apply-half-movement",
        "14": "can-apply-strength-up",
        "15": "can-apply-intelligence-up",
        "16": "can-apply-agility-up",
        "17": "can-apply-equipment-up",
        "18": "can-apply-quicken",
        "19": "can-apply-silence",
        "20": "can-apply-magic-ward",
        "21": "can-apply-regeneration",
        "22": "can-apply-paralysis",
        "23": "can-apply-poison",
        "24": "can-apply-numbness",
        "25": "can-apply-curse",
        "26": "can-apply-air-attack-up",
        "27": "can-apply-fire-attack-up",
        "28": "can-apply-earth-attack-up",
        "29": "can-apply-water-attack-up",
        "30": "can-apply-air-defense-up",
        "31": "can-apply-fire-defense-up",
        "32": "can-apply-earth-defense-up",
        "33": "can-apply-water-defense-up",
        "34": "can-apply-banish",
        "35": "can-apply-exorcise",
        "36": "can-apply-drain",
        "37": "unused-0",
        "38": "unused-1",
        "39": "unused-2"
      },
      "legacy_numeric_aliases": true,
      "description": "What the target must satisfy for the hit to apply."
    },
    {
      "name": "hit_function",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "follows-previous-hit",
        "2": "gem-modifier",
        "3": "agility-difference",
        "4": "intelligence-difference",
        "5": "agility-difference-2",
        "6": "risk",
        "7": "chain-evasion"
      },
      "legacy_numeric_aliases": true,
      "description": "How the chance to hit is rolled; none skips the roll."
    },
    {
      "name": "stat_calculator",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "last-value",
        "2": "physical-damage-without-status-modifiers",
        "3": "magic-damage",
        "4": "previous-hit-factor-0",
        "5": "hp-lost-factor",
        "6": "previous-hit-factor-1",
        "7": "current-hp-factor",
        "8": "weapon-pp",
        "9": "magic-damage-received-factor",
        "10": "physical-damage-received-factor-0",
        "11": "mp-lost-factor",
        "12": "trap-panel-damage",
        "13": "hp-healed",
        "14": "heal-panel-hp-healed",
        "15": "item-recovery",
        "16": "recoverable-hp",
        "17": "recoverable-mp",
        "18": "previous-hit-factor-2",
        "19": "magic-damage-received-of-type-factor",
        "20": "physical-damage-received-factor-1",
        "21": "spell-cost-factor",
        "22": "damage-received-factor",
        "23": "equipped-shield-dp",
        "24": "last-value-factor",
        "25": "physical-damage-with-status-modifiers",
        "26": "risk"
      },
      "legacy_numeric_aliases": true,
      "description": "How the hit's amount is worked out; none skips it."
    },
    {
      "name": "stat_factor",
      "type": "integer",
      "minimum": 0,
      "maximum": 31,
      "description": "The factor the stat calculator scales its amount by."
    },
    {
      "name": "damage_type",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "blunt",
        "2": "edged",
        "3": "piercing"
      },
      "legacy_numeric_aliases": true,
      "description": "The hit's damage type; none lets a physical hit use the equipped weapon's."
    },
    {
      "name": "affinity",
      "type": "enum",
      "enum": {
        "0": "weapon",
        "1": "physical",
        "2": "air",
        "3": "fire",
        "4": "earth",
        "5": "water",
        "6": "light",
        "7": "dark"
      },
      "legacy_numeric_aliases": true,
      "description": "The hit's element; weapon uses the drawn weapon's best affinity and is not allowed on healing hits."
    }
  ]
}
