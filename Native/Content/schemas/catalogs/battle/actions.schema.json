      "legacy_numeric_aliases": true,
      "description": "The effect package an action whose behavior has menu-action plays when it is presented, by asset id: asset.effect.e060.p is EFFECT/E060.P, whose textures are image.effect.e060_*. none plays no effect. Other actions never read it: a trap panel plays the package numbered like its action (action 6 plays asset.effect.e006.p) whatever this says. Actions may share a package. An action set to asset.effect.e039.p plays asset.effect.e036.p instead when its target is a treasure chest 17th or later in its room's chest list."
    },
    {
      "name": "range_x",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The targeting volume's extent, 32 world units a step. 255, on an action whose category has a chosen single target (as the base attacks do), takes the attacker's weapon extents (blade range plus reach) and angle in place of range_x, range_y, range_z and range_angle, keeping range_shape; actions with an area extent always use the values written."
    },
    {
      "name": "range_y",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The targeting volume's extent, 32 world units a step; replaced by the weapon's when range_x 255 takes the weapon extents."
    },
    {
      "name": "range_z",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The targeting volume's extent, 32 world units a step; replaced by the weapon's when range_x 255 takes the weapon extents."
    },
    {
      "name": "range_shape",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "ellipsoid",
        "2": "centered-cylinder",
        "3": "cylinder",
        "4": "cone",
        "5": "reversed-cone",
        "6": "rectangle",
        "7": "diamond"
      },
      "legacy_numeric_aliases": true,
      "description": "The targeting volume's shape; none means no volume."
    },
    {
      "name": "range_angle",
      "type": "integer",
      "minimum": 0,
      "maximum": 31,
      "description": "The targeting volume's pitch, in 11.25-degree steps (1/32 turn); replaced by the weapon's when range_x 255 takes the weapon extents."
    },
    {
      "name": "area_range_x",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The area of effect's extent around its target, 32 world units a step."
    },
    {
      "name": "area_range_y",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The area of effect's extent around its target, 32 world units a step."
    },
    {
      "name": "area_range_z",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The area of effect's extent around its target, 32 world units a step."
    },
    {
      "name": "area_shape",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "ellipsoid",
        "2": "centered-cylinder",
        "3": "cylinder",
        "4": "cone",
        "5": "reversed-cone",
        "6": "rectangle",
        "7": "diamond"
      },
      "legacy_numeric_aliases": true,
      "description": "The area of effect's shape; none means a single target."
    },
    {
      "name": "area_angle",
      "type": "integer",
      "minimum": 0,
      "maximum": 31,
      "description": "The volume's pitch, in 11.25-degree steps (1/32 turn)."
    },
    {
      "name": "behavior",
      "type": "flags",
      "enum": {
        "16": "special-mode",
        "32": "rarely-chosen",
        "64": "fallback-eligible",
        "128": "shaped-area",
        "256": "targets-unconditionally",
        "512": "targets-status-restricted",
        "1024": "targets-low-mp",
        "2048": "targets-low-hp",
        "4096": "ignores-sight",
        "8192": "radial-area",
        "16384": "beneficial",
        "32768": "harmful",
        "65536": "menu-action",
        "131072": "hits-first-obstruction",
        "262144": "starts-unlocked"
      },
      "legacy_numeric_aliases": false,
      "separator": "|",
      "empty_set": "none",
      "description": "Flags the battle and AI code read; ACTION_HITS.md section 4.7.2 defines each. The first twelve matter only when an enemy uses the action. harmful limits the AI to opponents and beneficial to allies; a beneficial action also needs targets-unconditionally or an ally matching targets-low-hp (HP below half), targets-low-mp or targets-status-restricted. ignores-sight allows a target out of sight; shaped-area and radial-area keep the target beyond the area's reach; rarely-chosen makes the AI pass the action over in 115 of 128 evaluations; fallback-eligible keeps it as a last resort; special-mode makes an enemy spawned in special-action mode skip its hit simulation. menu-action actions are chosen from a menu (cancelling targeting returns to it) and are presented with their effect rather than a melee animation; hits-first-obstruction hits the terrain or actor in the way instead of the target; starts-unlocked is the state a new game begins in."
    }
  ]
}
