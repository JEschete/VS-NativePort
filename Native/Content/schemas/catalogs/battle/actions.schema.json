{
  "schema_version": 1,
  "table": "actions",
  "description": "Every battle action: spells, abilities, break arts, items, traps and the base attacks. Hits are in action-hits.",
  "key": ["id"],
  "columns": [
    {
      "name": "id",
      "type": "id",
      "description": "Semantic identity: action.<name>, numbered when names repeat."
    },
    {
      "name": "display_name",
      "type": "text",
      "optional": true,
      "description": "Informational plain-text label; not a key or gameplay value."
    },
    {
      "name": "name",
      "type": "text",
      "description": "The name as the game shows it: ordinary spaces, {level} for the level glyph. It must encode to at most 23 game-text bytes."
    },
    {
      "name": "legacy_id",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The original table index, which saves, scripts and the learning catalog still use. Runs from 0 to 255 without gaps."
    },
    {
      "name": "kind",
      "type": "enum",
      "enum": {
        "0": "none",
        "1": "spell",
        "2": "ability",
        "3": "break-art",
        "4": "weapon-pp",
        "5": "item",
        "6": "base-attack",
        "7": "trap"
      },
      "legacy_numeric_aliases": true,
      "description": "What the action is. Spells spend MP, abilities RISK, break arts HP and weapon-pp actions the equipped weapon's PP; items and traps spend nothing here, and a base attack's cost comes from the weapon. No shipped action is weapon-pp."
    },
    {
      "name": "category",
      "type": "reference",
      "references": "action-categories",
      "description": "How the action picks and filters its targets."
    },
    {
      "name": "cost",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "How much of the kind's resource one use spends; 255 on the base attack means the weapon decides."
    },
    {
      "name": "recovery_delay",
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The delay before the actor acts again: the actor waits (this + its recovery bonus) * 256 / 35 battle updates. 255 means the equipped weapon's delay; actions 22-53 add no delay."
    },
    {
      "name": "camera_zoom",
      "type": "enum",
      "enum": {
        "0": "follow",
        "1": "zoom-in",
        "2": "zoom-out",
        "3": "hold"
      },
      "legacy_numeric_aliases": true,
      "description": "How the combat camera frames the action."
    },
