<?xml version="1.0" encoding="utf-8"?>
<!-- Shared settings for every project under Native\ (plan §0: x64, C++23, ClangCL). -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VSRepositoryRoot>$(MSBuildThisFileDirectory)</VSRepositoryRoot>
    <OutDir>$(VSRepositoryRoot)build\$(Configuration)\</OutDir>
    <IntDir>$(VSRepositoryRoot)build\$(Configuration)\obj\$(MSBuildProjectName)\</IntDir>
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestRoot>$(VSRepositoryRoot)</VcpkgManifestRoot>
    <VcpkgInstalledDir>$(VSRepositoryRoot)vcpkg_installed\</VcpkgInstalledDir>
    <VcpkgTriplet>x64-windows</VcpkgTriplet>
    <!-- Copied decomp C (.c, plan Step 4): sees every project's src\ and include\ plus the Legacy SDK layer, and
         keeps the old-C leniency as warnings. The pointer/integer casting warnings stay on and are counted
         (PORTING_WATCHLIST.md section 2). -->
    <VSNative>$(VSRepositoryRoot)Native\</VSNative>
    <VSCopiedCIncludes>$(VSNative)Engine;$(VSNative)Content;$(VSNative)Engine\include;$(VSNative)Engine\src;$(VSNative)Content\include;$(VSNative)Content\src;$(VSNative)Game\include;$(VSNative)Game\src</VSCopiedCIncludes>
    <VSCopiedCOptions>/J /clang:-Wno-error=int-conversion /clang:-Wno-error=incompatible-pointer-types /clang:-Wno-error=incompatible-function-pointer-types /clang:-Wno-error=implicit-function-declaration /clang:-Wno-error=implicit-int /clang:-Wno-error=return-type /clang:-Wno-error=int-to-pointer-cast /clang:-Wno-c2x-extensions /clang:-Wno-unused /clang:-Wno-parentheses /clang:-Wno-missing-braces /clang:-Wno-sign-compare /clang:-Wno-pointer-sign /clang:-Wno-switch /clang:-Wno-unknown-pragmas /clang:-Wno-microsoft-anon-tag /clang:-fms-extensions</VSCopiedCOptions>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <ConformanceMode>true</ConformanceMode>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- Native\ has files with the same name in different folders (Actors\Movement.c, Battle\Ai\Movement.c) and
           a copied .c next to a hand-written .cpp (Core\Random.c, Core\Random.cpp): one object per source path. -->
      <ObjectFileName>$(IntDir)%(RelativeDir)%(Filename)%(Extension).obj</ObjectFileName>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
