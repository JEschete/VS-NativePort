# Native (x86, 32-bit) target for the Vagrant Story port.
#
# Standalone by design: it does NOT touch the matching PSX build. Run the PSX
# build with plain `make`; run this with `make -f Makefile.native`.
#
#   make -f Makefile.native          build the native binary
#   make -f Makefile.native stubs    regenerate the stub layer
#   make -f Makefile.native test     build + run the GTE test harness
#
# Phase 0: compile the fully-decompiled MENU + TITLE subset against a stub layer.
# Phase 1: real software GTE (gte_core.c + libgte.c) replaces the GTE stubs.

NATIVE_CC ?= gcc
BUILD     := native/build
OBJ       := $(BUILD)/obj
BIN       := $(BUILD)/vagrant-native
TESTBIN   := $(BUILD)/test_gte

# Game code: PSYQ headers only (-nostdinc), 1997-compiler semantics preserved.
# -D_LANGUAGE_C is REQUIRED: most of include/psx/kernel.h (incl. struct DIRENTRY)
# is gated behind it, and the PSYQ compiler predefines it while modern GCC does not.
# -funsigned-char is REQUIRED and non-obvious: on MIPS/PSYQ `char` is UNSIGNED,
# and the decompiled code relies on it (e.g. string terminators read as
# `c = *charptr` and compared to 0xE7 / 0xFF). x86 gcc defaults `char` to
# SIGNED, so 0xE7 sign-extends to 0xFFFFFFE7, terminator checks fail, and string
# loops run away. Matching the PS1 ABI here fixes a whole class of latent bugs.
# _copyTitleBgData walks the compressed title background for MENUBGSZ bytes.
# Retail gets that from the extracted asset's size (config/TITLE/TITLE.PRG/
# Makefile does the same shell-out); the header's #ifndef fallback is wrong, so
# derive it the same way here rather than trusting the default.
TITLEBG_OBJ := build/assets/TITLE/TITLE.PRG/_titleScreenBg.rgba16Compressed.img.o
MENUBGSZ    := $(shell mipsel-linux-gnu-size $(TITLEBG_OBJ) 2>/dev/null | tail -n1 | awk '{print $$2}')
ifneq ($(MENUBGSZ),)
MENUBG_DEF  := -DMENUBGSZ=$(MENUBGSZ)
endif

GAME_CFLAGS := -m32 -std=gnu89 -nostdinc -DNATIVE_BUILD -D_LANGUAGE_C $(MENUBG_DEF) \
               -I include/psx -I src/include -I native/include -I ./ \
               -include native/include/psx_compat.h \
               -fno-builtin -fno-strict-aliasing -fwrapv -fno-pic \
               -funsigned-char -fno-stack-protector -w

# Platform layer: normal hosted C, may use libc.
#
# -idirafter: for -m32 gcc searches /usr/include/i386-linux-gnu, which does not
# exist here (libc6-dev-i386 provides the 32-bit libs, but the kernel UAPI
# headers only ship in the amd64 multiarch dir). Without this, anything pulling
# in <asm/*> -- errno.h, the socket headers used by the pad bridge -- fails to
# compile. Appending the dir (rather than -I, which prepends) means it is only
# consulted for headers not found elsewhere, so nothing already resolving gets
# shadowed. The x86 UAPI headers are shared between i386 and x86_64.
PLAT_CFLAGS := -m32 -I native/include -idirafter /usr/include/x86_64-linux-gnu \
               -fno-strict-aliasing -fwrapv -fno-pic -w
# Link below 16MB so real host pointers fit the 24-bit address fields the
# PS1 ordering table uses (see native/include/psx_gpu.h).
#
# --defsym D_1F800000/_camera=0x1F800000 mirrors the retail per-overlay Makefiles
# (config/*/Makefile): both symbols ALIAS the 1KB scratchpad. Without this they
# would be distinct blobs and the scratchpad views would diverge. The region is
# mmap(MAP_FIXED)'d at 0x1F800000 by native/platform/scratchpad.c before main().
LDFLAGS     := -m32 -no-pie -Wl,-Ttext-segment=0x10000 \
               -Wl,--defsym=D_1F800000=0x1F800000 \
               -Wl,--defsym=_camera=0x1F800000
# SDL2 is dlopen'd at runtime rather than linked (native/include/psx_present.h
# explains why: -m32 + Ubuntu's multiarch SDL headers would drag in i386 dev
# packages that can displace the mipsel cross-toolchain, and the window should
# stay optional so headless batch runs keep working). Hence just -ldl.
LDLIBS      := -ldl

# Translation units that cannot compile for x86 yet:
#  - hand-written inline MIPS asm in the C body (needs a NATIVE_BUILD C path,
#    same pattern as src/include/insertTPage.h)
#  - static vs non-static declaration conflicts (linkage-changing; must be
#    re-verified against the byte-matching build before touching)
#  - decompiled PSYQ functions that call straight into BIOS internals (e.g.
#    INTR.c's ResetCallback is `D_800320D4->unkC()`, a jump through the kernel's
#    callback vector table, which natively is a zeroed blob). The platform layer
#    owns those instead; everything else in such a TU is already assembly, so
#    excluding it costs no real code.
NATIVE_EXCLUDE := \
    src/BATTLE/BATTLE.PRG/38C1C.c \    src/BATTLE/BATTLE.PRG/4A0A8.c \    src/MENU/MENUB.PRG/260.c \    src/MENU/MENUF.PRG/3B8.c \    src/SLUS_010.40/libapi/COUNTER.c \    src/SLUS_010.40/libetc/INTR.c \    src/SLUS_010.40/libsn/SNMAIN.c \    src/SLUS_010.40/overlay.c \    src/TITLE/TITLE.PRG/libpress/LIBPRESS.c

# Everything else. INCLUDE_ASM is a no-op under NATIVE_BUILD, so TUs that still
# contain assembly contribute their data tables and decompiled functions, and
# the remaining assembly functions fall through to the generated stub layer.
GAME_SRCS := $(filter-out $(NATIVE_EXCLUDE),$(shell find src -name "*.c" | sort))

# Read-only data tables copied verbatim from the retail overlays (menu strings,
# glyph widths, animation/colour tables). Curated -- only genuine .rodata the
# render path reads, never .bss runtime state. Regenerate with `make harvest`.
# Harvested symbols are DEFINED by harvested_data.o, so gen_stubs.py sees them
# as satisfied and does not emit zero blobs for them -- no exclusion list needed.
# The sound driver's lookup tables. All of these are initialised .data in the
# retail executable that no decompiled C defines, so without harvesting them the
# stub layer hands the driver arrays of zeroes -- silently, and with the driver
# then reading every opcode as zero-length and every note as zero-duration.
#
#   D_8002F5A0/D_8002F600  operand byte counts, per VM opcode
#   D_8002F620             note-length table
#   D_8002F69C/D_8002F89C  pitch and envelope curves
#   g_Sound_StereoPanGainTableQ15  pan law
#   D_8002F99C..D_80030184 the sixteen LFO waveforms g_Sound_LfoTable indexes
#
# g_Sound_LfoTable itself is deliberately NOT harvested: it is an array of
# pointers, and the retail bytes are PSX addresses. It is rebuilt as real C in
# native/platform/sound_tables.c, same as the three dispatch tables.
SOUND_HARVEST := D_8002F548 D_8002F54C D_8002F550 D_8002F5A0 D_8002F600 \
                 D_8002F620 D_8002F63C D_8002F66C D_8002F69C D_8002F89C \
                 g_Sound_StereoPanGainTableQ15 \
                 D_8002F99C D_8002F9B4 D_8002F9C0 D_8002F9D4 D_8002F9E0 \
                 D_8002F9F4 D_8002FA00 D_8002FB40 D_8002FB94 D_8002FC3C \
                 D_8002FC6C D_8002FCF4 D_8002FD1C D_8002FF24 D_8003012C \
                 D_80030184

HARVEST_SYMS := vs_battle_menuStrings vs_battle_characterWidths \
                vs_battle_rowAnimationSteps \
                D_800EB708 D_800EB7B4 D_800EB7D4 \
                _titleScreenBg \
                $(SOUND_HARVEST)

# Real implementations (must be linked BEFORE stubs are generated so their
# symbols are excluded from stubbing).
PLAT_REAL := native/platform/unimpl.c native/platform/scratchpad.c \
             native/platform/gte_core.c native/platform/libgte.c \
             native/platform/libgpu.c native/platform/libetc.c \
             native/platform/psx_vram.c native/platform/libapi.c \
             native/platform/battle_asm.c native/platform/battle_menu.c \
             native/platform/battle_textbox.c native/platform/harvested_data.c \
             native/platform/libpad.c native/platform/present.c \
             native/platform/libds.c native/platform/libspu.c \
             native/platform/disc_index.c native/platform/kernel.c \
             native/platform/sound_asm.c native/platform/sound_tables.c \
             native/platform/audio_sink.c native/platform/cdxa.c \
             native/platform/assets.c \
             native/platform/mdec.c native/platform/libpress.c \
             native/platform/libstream.c native/platform/spu_core.c \
             native/platform/main.c
PLAT_SRCS := $(PLAT_REAL) native/platform/stubs.c

GAME_OBJS := $(foreach s,$(GAME_SRCS),$(OBJ)/game_$(subst /,_,$(patsubst src/%.c,%,$(s))).o)
REAL_OBJS := $(patsubst native/platform/%.c,$(OBJ)/plat_%.o,$(PLAT_REAL))
STUB_OBJ  := $(OBJ)/plat_stubs.o

.PHONY: all clean run stubs test menu window harvest discindex assets mdectest
all: $(BIN)

# harvested_data.c holds real read-only bytes copied from the retail overlays,
# so it is GENERATED (never committed), exactly like data/ and disks/. The build
# regenerates it from the user-owned binaries, so a fresh checkout just works.
native/platform/harvested_data.c: native/tools/harvest_data.py
	@echo "  HARVEST  $@"
	@python3 native/tools/harvest_data.py native/platform/harvested_data.c \
		native/platform/harvested.syms $(HARVEST_SYMS)

harvest: native/platform/harvested_data.c

# LBA -> extracted-file map, so the port reads assets from data/ instead of
# needing the disc image at runtime. Generated (never committed), like data/.
native/platform/disc_index.c: native/tools/gen_disc_index.py config/SLUS-01040.xml
	@echo "  DISCIDX  $@"
	@python3 native/tools/gen_disc_index.py $@

discindex: native/platform/disc_index.c

# Overlay binary assets (compressed title background, font tables). Generated,
# never committed -- same rationale as data/ and harvested_data.c.
native/platform/assets.c: native/tools/gen_assets.py
	@echo "  ASSETS   $@"
	@python3 native/tools/gen_assets.py $@

assets: native/platform/assets.c

$(OBJ):
	@mkdir -p $(OBJ)

# The PSX build pipes every C file through the vsString transformer
# (tools/make/compile.mk: cpp | vsStringTransformer | cc1 | maspsx). It re-encodes
# character/string literals inside `#pragma vsstring` blocks into VS's font
# encoding (e.g. '\f' -> 0xE5, the "new page" control code). Without it, the
# native build compiles those literals as plain ASCII, which breaks glyph
# thresholds in the text renderers (_printVariableWidthFont) and any vsstring
# table. Mirror the PSX pipeline: preprocess, transform, then compile.
VSSTRING := PYTHONPATH=tools/etc python3 tools/etc/vsStringTransformer.py

define GAME_RULE
$(OBJ)/game_$(subst /,_,$(patsubst src/%.c,%,$(1))).o: $(1) | $(OBJ)
	@echo "  CC(game) $(1)"
	@$(NATIVE_CC) $(GAME_CFLAGS) -E $(1) | $(VSSTRING) | \
	 $(NATIVE_CC) $(GAME_CFLAGS) -x cpp-output -c - -o $$@
endef
$(foreach s,$(GAME_SRCS),$(eval $(call GAME_RULE,$(s))))

$(OBJ)/plat_%.o: native/platform/%.c | $(OBJ)
	@echo "  CC(plat) $<"
	@$(NATIVE_CC) $(PLAT_CFLAGS) -c $< -o $@

$(BIN): $(GAME_OBJS) $(REAL_OBJS) $(STUB_OBJ)
	@echo "  LD       $@"
	@$(NATIVE_CC) $(LDFLAGS) $^ $(LDLIBS) -o $@
	@echo "native target linked: $@"

# Regenerate the stub layer from whatever is still unresolved after the real
# implementations are accounted for.
# Every host library whose symbols must bind for real rather than be stubbed.
# libm matters as much as libc: an unlisted library function is not glabel'd in
# the disassembly either, so it would be emitted as a zeroed DATA blob and
# calling it would jump into an array of zeroes.
LIBC := $(shell $(NATIVE_CC) -m32 -print-file-name=libc.so.6)
LIBM := $(shell $(NATIVE_CC) -m32 -print-file-name=libm.so.6)
stubs: $(GAME_OBJS) $(REAL_OBJS)
	@python3 native/tools/gen_stubs.py $(OBJ) native/platform/stubs.c $(LIBC),$(LIBM)

test: | $(OBJ)
	@$(NATIVE_CC) $(GAME_CFLAGS) -c src/SLUS_010.40/31724.c -o $(OBJ)/t_trigdata.o
	@$(NATIVE_CC) $(PLAT_CFLAGS) -c native/platform/libgte.c -o $(OBJ)/t_libgte.o
	@$(NATIVE_CC) $(PLAT_CFLAGS) -no-pie native/tests/test_gte.c native/platform/gte_core.c 		$(OBJ)/t_libgte.o $(OBJ)/t_trigdata.o -lm -o $(TESTBIN)
	@./$(TESTBIN) native/tests/gte_golden.txt
	@$(NATIVE_CC) $(PLAT_CFLAGS) $(LDFLAGS) native/tests/test_gpu.c \
		native/platform/libgpu.c native/platform/psx_vram.c -o $(BUILD)/test_gpu
	@./$(BUILD)/test_gpu

# Offline check of the software MDEC against the real movie stream: demuxes
# data/MOV/TITLE.STR and decodes every frame, reporting any whose macroblock
# count does not match its dimensions. Also dumps the first few frames as PPMs.
# BUILD.c is game code (PSYQ headers, -nostdinc), so it needs GAME_CFLAGS: the
# decode table the test uses is built by the retail routine, not reconstructed.
mdectest: | $(OBJ)
	@$(NATIVE_CC) $(GAME_CFLAGS) -c src/TITLE/TITLE.PRG/libpress/BUILD.c -o $(OBJ)/t_vlcbuild.o
	@$(NATIVE_CC) $(PLAT_CFLAGS) -no-pie native/tests/mdec_test.c \
		native/platform/mdec.c $(OBJ)/t_vlcbuild.o -lm -o $(BUILD)/mdec_test
	@./$(BUILD)/mdec_test

run: $(BIN)
	@./$(BIN)

clean:
	$(RM) -r $(BUILD)

MENUBIN := $(BUILD)/menu_harness

$(MENUBIN): $(GAME_OBJS) $(REAL_OBJS) $(STUB_OBJ) native/tests/menu_harness.c
	@echo "  CC(test) native/tests/menu_harness.c"
	@$(NATIVE_CC) $(PLAT_CFLAGS) -c native/tests/menu_harness.c -o $(OBJ)/menu_harness.o
	@echo "  LD       $@"
	@$(NATIVE_CC) $(LDFLAGS) \
		$(filter-out $(OBJ)/plat_main.o,$(GAME_OBJS) $(REAL_OBJS) $(STUB_OBJ)) \
		$(OBJ)/menu_harness.o $(LDLIBS) -o $@

# Batch run: no window, fixed 130-frame script, dumps native/build/menu.ppm.
# This is the regression path -- keep its output stable.
menu: $(MENUBIN)
	@echo "---- run: headless ----"
	-@VS_HEADLESS=1 ./$(MENUBIN)

# Interactive run: opens a real window and takes live input. Plug in a pad on
# the Windows side with `python native/tools/pad_bridge.py` (WSL cannot see USB
# or Bluetooth devices); the keyboard always works.
window: $(MENUBIN)
	@echo "---- run: windowed ----"
	-@./$(MENUBIN)
